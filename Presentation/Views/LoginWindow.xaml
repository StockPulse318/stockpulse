<Window x:Class="WarehouseInventory.Presentation.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WarehouseInventory.Presentation.Converters"
        mc:Ignorable="d"
        Title="StockPulse — Warehouse Inventory Management System"
        Width="440" Height="460" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=UsernameBox}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2D3748"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style x:Key="InputBox" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Padding="32">
        <StackPanel VerticalAlignment="Center">
            <!-- Header -->
            <TextBlock Text="StockPulse" FontSize="26" FontWeight="Bold" Foreground="#1A365D" HorizontalAlignment="Center"/>
            <TextBlock Text="Warehouse Inventory Management System" FontSize="13" Foreground="#718096" Margin="0,4,0,20" HorizontalAlignment="Center"/>

            <!-- Form Card -->
            <Border Background="White" CornerRadius="8" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Sign In" FontSize="18" FontWeight="SemiBold" Foreground="#2D3748" Margin="0,0,0,8"/>

                    <TextBlock Text="Username" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource InputBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="1"/>

                    <TextBlock Text="Password" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PasswordInputBox"
                                 Style="{StaticResource InputBox}"
                                 TabIndex="2"
                                 PasswordChanged="PasswordInputBox_PasswordChanged"/>

                    <!-- Error State Message -->
                    <Border Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,12,0,0"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Loading Progress -->
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <!-- Action Button -->
                    <Button x:Name="LoginBtn"
                            Content="Log In"
                            Height="38"
                            Margin="0,16,0,0"
                            Background="#2B6CB0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsDefault="True"
                            TabIndex="3"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>
                </StackPanel>
            </Border>

            <!-- Keyboard shortcut hint -->
            <TextBlock Text="Press Enter to sign in • Tab to move" FontSize="11" Foreground="#A0AEC0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</Window>
