<Window x:Class="WarehouseInventory.Presentation.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
            <TextBlock Text="{Binding Message}" FontSize="13" Foreground="#475569" Margin="0,10,0,20" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Height="32" Width="80"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Content="Confirm" Height="32" Width="90" Margin="8,0,0,0"
                        Background="#DC2626" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        IsDefault="True" Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
