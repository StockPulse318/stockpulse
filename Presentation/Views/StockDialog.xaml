<Window x:Class="WarehouseInventory.Presentation.Views.StockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WarehouseInventory.Presentation.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=AmountInput}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
            <TextBlock Text="{Binding ProductInfo}" FontSize="12" Foreground="#64748B" Margin="0,4,0,16"/>

            <TextBlock Text="{Binding OperationLabel}" FontSize="13" FontWeight="Medium" Foreground="#334155" Margin="0,0,0,4"/>
            <TextBox x:Name="AmountInput" Height="34" FontSize="14" Padding="8,4"
                     BorderBrush="#CBD5E1" Background="White"
                     Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                     TabIndex="1"/>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,10,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Height="32" Width="80" TabIndex="3"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Content="{Binding ActionButtonText}" Height="32" Padding="14,0" TabIndex="2"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        IsDefault="True" Command="{Binding ConfirmCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
