<Window x:Class="WarehouseInventory.Presentation.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WarehouseInventory.Presentation.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=NameInput}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <Style x:Key="FormInput" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>

            <!-- Product Name -->
            <TextBlock Text="Product Name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameInput" Style="{StaticResource FormInput}"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" TabIndex="1"/>

            <!-- Category (Dropdown fed by endpoint, never typed freely) -->
            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
            <ComboBox Style="{StaticResource FormInput}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      IsEditable="False"
                      TabIndex="2"/>

            <!-- Price and Reorder Level in 2 columns -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Unit Price -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Unit Price (GH₵)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource FormInput}"
                             Text="{Binding UnitPriceText, UpdateSourceTrigger=PropertyChanged}" TabIndex="3"/>
                </StackPanel>

                <!-- Reorder Level -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Reorder Level" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource FormInput}"
                             Text="{Binding ReorderLevelText, UpdateSourceTrigger=PropertyChanged}" TabIndex="4"/>
                </StackPanel>
            </Grid>

            <!-- Quantity (Only editable during creation) -->
            <TextBlock Text="Initial Quantity" Style="{StaticResource FieldLabel}"
                       Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVis}}"/>
            <TextBox Style="{StaticResource FormInput}"
                     Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVis}}"
                     TabIndex="5"/>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,14,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" Height="34" Width="80" TabIndex="7"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1"
                        IsCancel="True" Command="{Binding CancelCommand}"/>
                <Button Content="Save Product" Height="34" Padding="16,0" TabIndex="6"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        IsDefault="True" Command="{Binding SaveCommand}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
