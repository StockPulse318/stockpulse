<Window x:Class="WarehouseInventory.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:WarehouseInventory.Presentation.Converters"
        mc:Ignorable="d"
        Title="StockPulse — Warehouse Inventory Management System"
        Width="1100" Height="700" MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>

        <Style x:Key="NavTabButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="PrimaryToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Application Header -->
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="StockPulse" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,12,0"/>
                    <Border Background="#334155" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="WIMS Client" FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                        <TextBlock Text="{Binding UserDisplay}" FontSize="12" Foreground="#E2E8F0"/>
                    </Border>
                    <Button Content="Log Out" Command="{Binding LogoutCommand}"
                            Background="#334155" Foreground="White" BorderThickness="0"
                            Padding="10,4" FontSize="12" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigation Tabs Bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0">
            <StackPanel Orientation="Horizontal">
                <!-- All Products Tab -->
                <Button Content="Inventory List"
                        Command="{Binding SwitchTabCommand}" CommandParameter="All">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlertsTabActive}" Value="False">
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Low Stock Alerts Tab with Badge -->
                <Button Command="{Binding SwitchTabCommand}" CommandParameter="Alerts" Margin="8,0,0,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAlertsTabActive}" Value="True">
                                    <Setter Property="Foreground" Value="#D97706"/>
                                    <Setter Property="BorderBrush" Value="#D97706"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Low-Stock Alerts" VerticalAlignment="Center"/>
                        <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="10"
                                Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding LowStockCount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding LowStockCount}" FontSize="11" FontWeight="Bold" Foreground="#B45309"/>
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Action Toolbar -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <!-- Right Side Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <!-- Stock Movement (Clerk & Manager) -->
                    <Button Content="Stock In" Style="{StaticResource ToolButton}"
                            Command="{Binding StockInCommand}"
                            ToolTip="Increase stock quantity for selected product"/>
                    <Button Content="Stock Out" Style="{StaticResource ToolButton}"
                            Command="{Binding StockOutCommand}"
                            ToolTip="Reduce stock quantity for selected product"/>

                    <!-- Separator -->
                    <Rectangle Width="1" Height="20" Fill="#CBD5E1" Margin="8,0,4,0"
                               Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVis}}"/>

                    <!-- Manager Only Operations -->
                    <Button Content="Edit" Style="{StaticResource ToolButton}"
                            Command="{Binding EditProductCommand}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVis}}"
                            ToolTip="Edit selected product attributes"/>
                    <Button Content="Delete" Style="{StaticResource ToolButton}"
                            Command="{Binding DeleteProductCommand}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVis}}"
                            ToolTip="Delete selected product"/>
                    <Button Content="+ Add Product" Style="{StaticResource PrimaryToolButton}"
                            Command="{Binding AddProductCommand}"
                            Visibility="{Binding CanManageProducts, Converter={StaticResource BoolToVis}}"
                            ToolTip="Add a new product to inventory"/>
                </StackPanel>

                <!-- Left Side: Search & Filter -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <Grid Width="240">
                        <TextBox x:Name="SearchBoxInput"
                                 Height="32" Padding="8,4" FontSize="13"
                                 BorderBrush="#CBD5E1" Background="White"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Search name or ID..."
                                   Foreground="#94A3B8" FontSize="12" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText.Length, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>

                    <!-- Category Filter -->
                    <ComboBox Height="32" Width="170" Margin="8,0,0,0"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              ToolTip="Filter by Category"/>

                    <!-- Refresh Button -->
                    <Button Content="Refresh" Style="{StaticResource ToolButton}"
                            Command="{Binding RefreshCommand}" Margin="8,0,0,0"
                            ToolTip="Reload latest inventory from server"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom Pagination Bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock Text="{Binding PageInfo}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" DockPanel.Dock="Left"/>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Previous" Style="{StaticResource ToolButton}"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding HasPreviousPage}"/>
                    <Button Content="Next" Style="{StaticResource ToolButton}"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding HasNextPage}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Background="White">
            <!-- Loading Indicator overlay -->
            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Panel.ZIndex="10"/>

            <!-- Error Banner -->
            <Border Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" Margin="16" Padding="12"
                    VerticalAlignment="Top" CornerRadius="6" Panel.ZIndex="9"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button Content="Retry" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="No inventory records found" FontSize="16" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center"/>
                <TextBlock Text="Try adjusting your search terms or category filter." FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Products DataGrid -->
            <DataGrid x:Name="InventoryGrid"
                      ItemsSource="{Binding DisplayedProducts}"
                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F1F5F9"
                      BorderThickness="0"
                      Background="White"
                      RowHeight="36"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.IsDeferredScrollingEnabled="False"
                      CanUserSortColumns="False"
                      MouseDoubleClick="InventoryGrid_MouseDoubleClick">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <!-- Highlight rows needing restock -->
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter Property="Background" Value="#FEFCE8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Product ID -->
                    <DataGridTemplateColumn Width="95">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Product ID" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Id"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" Style="{StaticResource RightText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Product Name -->
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Product Name" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Name"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="8,0" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Category -->
                    <DataGridTemplateColumn Width="160">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Category" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Category"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Category}" VerticalAlignment="Center" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Quantity -->
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Quantity" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="Quantity"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Quantity}" Style="{StaticResource RightText}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unit Price -->
                    <DataGridTemplateColumn Width="130">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Unit Price" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="UnitPrice"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UnitPriceFormatted}" Style="{StaticResource RightText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Reorder Level -->
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.Header>
                            <Button Content="Reorder Level" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="ReorderLevel"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ReorderLevel}" Style="{StaticResource RightText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Stock Status Warning -->
                    <DataGridTemplateColumn Header="Status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="6,2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F1F5F9"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#64748B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
