<Window x:Class="WarehouseInventory.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset User Password" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="18,14,18,16">
        <TextBlock x:Name="HeaderTitle" Text="Reset Password" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="Specify a new secure temporary password for this user (minimum 8 characters)." Foreground="#666" FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="New Password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="NewPasswordBox" Height="26"/>

        <TextBlock Text="Confirm Password" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
        <PasswordBox x:Name="ConfirmPasswordBox" Height="26"/>

        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" MinHeight="18" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Update Password" IsDefault="True" Style="{StaticResource MainButton}" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
