<Window x:Class="WarehouseInventory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warehouse Inventory Management System" Width="1040" Height="640"
        MinWidth="860" MinHeight="460" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBrush}">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White">
            <MenuItem Header="_File">
                <MenuItem Header="_Log out" Click="LogOut_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Users" x:Name="UsersMenuItem">
                <MenuItem Header="_Manage User Accounts..." Click="ManageUsers_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource AccentBrush}" Foreground="White">
            <StatusBarItem><TextBlock x:Name="CountText"/></StatusBarItem>
            <Separator/>
            <StatusBarItem><TextBlock x:Name="UserText"/></StatusBarItem>
        </StatusBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- toolbar: right-docked buttons are listed right to left -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <Button x:Name="ManageUsersButton" Content="_Manage Users" DockPanel.Dock="Right" Click="ManageUsers_Click"/>
                <Button x:Name="DeleteButton" Content="_Delete" DockPanel.Dock="Right" Click="Delete_Click"/>
                <Button x:Name="EditButton" Content="_Edit" DockPanel.Dock="Right" Click="Edit_Click"/>
                <Button x:Name="AddButton" Content="_Add Product" DockPanel.Dock="Right" Style="{StaticResource MainButton}" Click="Add_Click"/>
                <Button x:Name="StockOutButton" Content="Stock _Out" DockPanel.Dock="Right" Click="StockOut_Click"/>
                <Button x:Name="StockInButton" Content="Stock _In" DockPanel.Dock="Right" Click="StockIn_Click"/>

                <Grid Width="220" DockPanel.Dock="Left">
                    <TextBox x:Name="SearchBox" Height="28" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Search by name or ID" Foreground="Gray"
                               IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ComboBox x:Name="BranchFilterBox" DockPanel.Dock="Left" Width="145" Height="28" Margin="8,0,0,0"
                          ToolTip="Filter by warehouse branch" SelectionChanged="Filter_Changed"/>
                <ComboBox x:Name="CategoryFilterBox" DockPanel.Dock="Left" Width="145" Height="28" Margin="8,0,0,0"
                          ToolTip="Filter by product category" SelectionChanged="Filter_Changed"/>
                <CheckBox x:Name="LowOnlyBox" Content="Low stock only" DockPanel.Dock="Left"
                          VerticalAlignment="Center" Margin="12,0,0,0"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            </DockPanel>

            <!-- low stock warning -->
            <Border x:Name="AlertBar" Grid.Row="1" Background="#FFF4CE" BorderBrush="#E5C76B"
                    BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
                <DockPanel>
                    <Button Content="Show them" DockPanel.Dock="Right" Padding="10,0" MinHeight="22" Click="ShowLow_Click"/>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="Low stock: " FontWeight="Bold"/><Run x:Name="AlertText"/>
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <DataGrid x:Name="ProductGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#D9D9D9" VerticalGridLinesBrush="#D9D9D9"
                          AlternatingRowBackground="#FAFAFA" Background="White" RowHeaderWidth="0"
                          SelectionChanged="ProductGrid_SelectionChanged"
                          MouseDoubleClick="ProductGrid_DoubleClick" KeyDown="ProductGrid_KeyDown">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CCE4F7"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#CCE4F7"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="Black"/>
                        <Style x:Key="RightText" TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Product ID" Binding="{Binding Id}" Width="85"/>
                        <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Branch / Warehouse" Binding="{Binding Branch}" Width="150"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
                        <DataGridTemplateColumn Header="Quantity (tick = reorder level)" Width="270" SortMemberPath="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="12">
                                            <ProgressBar Minimum="0" Maximum="100" Background="#E6E6E6"
                                                         Value="{Binding LevelPercent, Mode=OneWay}"
                                                         Foreground="{Binding BarBrush}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BeforeTick}"/>
                                                    <ColumnDefinition Width="{Binding AfterTick}"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="2" Margin="0,-3" Fill="Black" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Quantity}" FontWeight="SemiBold" MinWidth="34" TextAlignment="Right"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                                       FontWeight="SemiBold" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Reorder Level" Binding="{Binding ReorderLevel}" Width="110"
                                            ElementStyle="{StaticResource RightText}"/>
                        <DataGridTextColumn Header="Unit Price (GH₵)" Binding="{Binding UnitPrice, StringFormat=N2}" Width="120"
                                            ElementStyle="{StaticResource RightText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyText" Text="No products found. Try a different name or ID."
                           Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
