<Window x:Class="WarehouseInventory.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="18,8,18,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Product ID" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="IdBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="CategoryBox" IsEditable="True" Height="26"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Product name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Quantity" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="QuantityBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Reorder level" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ReorderBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Unit price (GH₵)" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="PriceBox"/>

        <TextBlock x:Name="HintText" Foreground="#666" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" MinHeight="20" Margin="0,6,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" IsDefault="True" Style="{StaticResource MainButton}" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
