<Window x:Class="WarehouseInventory.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StockPulse - User Governance &amp; Multi-Branch Permissions" Width="920" Height="620"
        MinWidth="780" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="User Governance &amp; Multi-Branch Permissions" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Manage user accounts, assign roles, enforce branch access, and control system activation."
                           Foreground="#666" Margin="0,2,0,0" FontSize="12"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <TextBlock x:Name="LoggedInUserBadge" Text="Logged in as Admin" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
            </Border>
        </DockPanel>

        <!-- Create User Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Provision New User Account" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Full Name" FontSize="11" Foreground="#555"/>
                        <TextBox x:Name="NewFullNameBox" Margin="0,2,0,0" Height="26"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Username" FontSize="11" Foreground="#555"/>
                        <TextBox x:Name="NewUsernameBox" Margin="0,2,0,0" Height="26"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Password" FontSize="11" Foreground="#555"/>
                        <PasswordBox x:Name="NewPasswordBox" Margin="0,2,0,0" Height="26"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Role" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="NewRoleBox" Margin="0,2,0,0" Height="26" SelectedIndex="0">
                            <ComboBoxItem Content="Stock Clerk"/>
                            <ComboBoxItem Content="Warehouse Manager"/>
                            <ComboBoxItem Content="Administrator"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="8">
                        <TextBlock Text="Branch Assignment" FontSize="11" Foreground="#555"/>
                        <ComboBox x:Name="NewBranchBox" IsEditable="True" Margin="0,2,0,0" Height="26"/>
                    </StackPanel>

                    <Button x:Name="AddUserButton" Content="+ Add User" Grid.Column="10" VerticalAlignment="Bottom"
                            Height="26" Padding="12,0" Style="{StaticResource MainButton}" Click="AddUser_Click"/>
                </Grid>
                <TextBlock x:Name="FormErrorText" Foreground="#C42B1C" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Search and Filters Bar -->
        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
            <Grid Width="220" DockPanel.Dock="Left">
                <TextBox x:Name="SearchBox" Height="28" TextChanged="SearchBox_TextChanged"/>
                <TextBlock x:Name="SearchHint" Text="Search by name or username" Foreground="Gray"
                           IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </Grid>

            <ComboBox x:Name="BranchFilterBox" DockPanel.Dock="Left" Width="150" Height="28" Margin="8,0,0,0"
                      ToolTip="Filter by assigned branch" SelectionChanged="Filter_Changed"/>

            <ComboBox x:Name="RoleFilterBox" DockPanel.Dock="Left" Width="150" Height="28" Margin="8,0,0,0"
                      ToolTip="Filter by user role" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All Roles" IsSelected="True"/>
                <ComboBoxItem Content="Administrator"/>
                <ComboBoxItem Content="Warehouse Manager"/>
                <ComboBoxItem Content="Stock Clerk"/>
            </ComboBox>

            <ComboBox x:Name="StatusFilterBox" DockPanel.Dock="Left" Width="130" Height="28" Margin="8,0,0,0"
                      ToolTip="Filter by status" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="All Statuses" IsSelected="True"/>
                <ComboBoxItem Content="Active Only"/>
                <ComboBoxItem Content="Suspended Only"/>
            </ComboBox>

            <Button Content="Refresh" DockPanel.Dock="Right" Height="28" Padding="12,0" Click="Refresh_Click"/>
        </DockPanel>

        <!-- User Accounts DataGrid -->
        <DataGrid x:Name="UsersGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                  SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="All"
                  HorizontalGridLinesBrush="#E5E7EB" VerticalGridLinesBrush="#E5E7EB"
                  AlternatingRowBackground="#FAFAFA" Background="White" RowHeaderWidth="0"
                  SelectionChanged="UsersGrid_SelectionChanged" MouseDoubleClick="UsersGrid_MouseDoubleClick">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="120" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Full Name" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="150"/>
                <DataGridTextColumn Header="Assigned Branch" Binding="{Binding AssignedBranch}" Width="150"/>
                <DataGridTemplateColumn Header="Status" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                    Background="{Binding StatusBadgeBrush}">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Permissions" Binding="{Binding RoleDescription}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer / Action Bar -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="UserCountText" Text="Loading users..." VerticalAlignment="Center" Foreground="#555" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EditUserButton" Content="Edit Profile / Role" Margin="0,0,8,0" IsEnabled="False" Click="EditUser_Click"/>
                <Button x:Name="ResetPasswordButton" Content="Reset Password" Margin="0,0,8,0" IsEnabled="False" Click="ResetPassword_Click"/>
                <Button x:Name="ToggleStatusButton" Content="Toggle Status" Margin="0,0,8,0" IsEnabled="False" Click="ToggleStatus_Click"/>
                <Button x:Name="DeleteUserButton" Content="Delete Account" Margin="0,0,8,0" IsEnabled="False" Click="DeleteUser_Click"/>
                <Button Content="Close" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
