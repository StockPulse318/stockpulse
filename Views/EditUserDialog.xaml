<Window x:Class="WarehouseInventory.Views.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit User Profile &amp; Role" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource PanelBrush}">
    <StackPanel Margin="18,14,18,16">
        <TextBlock x:Name="HeaderTitle" Text="Edit User Profile" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="Modify account role, assigned warehouse branch, and access status." Foreground="#666" FontSize="12" Margin="0,0,0,12"/>

        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="UsernameBox" IsReadOnly="True" Background="#F0F0F0" Height="26"/>

        <TextBlock Text="Full Name / Display Name" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="FullNameBox" Height="26"/>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Role &amp; Permissions" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="RoleBox" Height="26">
                    <ComboBoxItem Content="Stock Clerk"/>
                    <ComboBoxItem Content="Warehouse Manager"/>
                    <ComboBoxItem Content="Administrator"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Account Status" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="StatusBox" Height="26">
                    <ComboBoxItem Content="Active (Enabled)"/>
                    <ComboBoxItem Content="Suspended (Disabled)"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock Text="Assigned Warehouse Branch" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="BranchBox" IsEditable="True" Height="26"/>

        <TextBlock x:Name="HintText" Foreground="#666" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" MinHeight="18" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save Changes" IsDefault="True" Style="{StaticResource MainButton}" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
